{
  "name": "bilayer",
  "version": "0.4.1",
  "description": "Safari web extension that shows two subtitle lines on streaming video pages, with optional AI translation through an OpenAI-compatible service.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Senn-s-Team/bilayer.git"
  },
  "homepage": "https://github.com/Senn-s-Team/bilayer#readme",
  "bugs": {
    "url": "https://github.com/Senn-s-Team/bilayer/issues"
  },
  "keywords": [
    "safari-extension",
    "webextension",
    "subtitles",
    "dual-subtitles",
    "translation"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "icons": "bash scripts/build-icons.sh",
    "test": "node --test scripts/*.test.mjs",
    "safari:project": "bash scripts/create-safari-project.sh",
    "package:dmg": "bash scripts/package-dmg.sh",
    "install:app": "bash scripts/install-app.sh"
  }
}
