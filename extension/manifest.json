{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "0.3.5",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png",
    "1024": "icons/icon-source.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://netflix.com/*", "https://www.netflix.com/*", "https://*.nflxvideo.net/*", "https://api.openai.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "__MSG_extActionTitle__",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://netflix.com/*", "https://www.netflix.com/*"],
      "js": [
        "src/content/subtitleParser.js",
        "src/content/subtitleStore.js",
        "src/content/netflixAdapter.js",
        "src/content/translationScheduler.js",
        "src/content/overlay.js",
        "src/content/fullscreenMount.js",
        "src/content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/page/netflix-page-bridge.js"],
      "matches": ["https://netflix.com/*", "https://www.netflix.com/*"]
    }
  ]
}
