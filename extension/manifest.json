{
  "manifest_version": 3,
  "name": "Netflix Dual Subtitles Safari",
  "version": "0.2.1",
  "description": "Show a second subtitle track on Netflix Web in Safari.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://netflix.com/*", "https://www.netflix.com/*", "https://*.nflxvideo.net/*", "https://api.openai.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "Netflix Dual Subtitles",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://netflix.com/*", "https://www.netflix.com/*"],
      "js": [
        "src/content/subtitleParser.js",
        "src/content/subtitleStore.js",
        "src/content/netflixAdapter.js",
        "src/content/translationScheduler.js",
        "src/content/overlay.js",
        "src/content/fullscreenMount.js",
        "src/content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/page/netflix-page-bridge.js"],
      "matches": ["https://netflix.com/*", "https://www.netflix.com/*"]
    }
  ]
}
